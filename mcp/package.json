{
  "name": "pinelab-engineering-mcp",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "npm run generate:skills && wrangler dev",
    "generate:skills": "node src/scripts/generate-skills.mjs",
    "pretest": "npm run generate:skills",
    "test": "tsx --test src/*.test.ts test/*.test.ts",
    "precheck": "npm run generate:skills",
    "check": "tsc --noEmit",
    "dev:worker": "wrangler dev",
    "build:worker": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.152.0"
  }
}
